# ============================================================
# SFPRS — Environment Variable Template
# Copy this to each service's .env file and fill in values
# ⚠  NEVER commit .env files to git — only commit this template
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=sfprs_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=sfprs_db

# ── Auth Service (port 3001) ──────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_STRING
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MS=1800000

# ── CORS ──────────────────────────────────────────────────────
# In production: set to your deployed domain, e.g. https://sfprs.microlinkit.edu.et
CLIENT_ORIGIN=http://localhost:5500

# ── Service Ports ─────────────────────────────────────────────
PORT=3001          # auth-service
# PORT=3002        # student-service
# PORT=3003        # finance-service
# PORT=3004        # notification-service
# PORT=3005        # report-service

# ── Notification Service ──────────────────────────────────────
NOTIFY_SERVICE_URL=http://localhost:3004
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@microlinkit.edu.et
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=SFPRS <noreply@microlinkit.edu.et>

# ── Node environment ──────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
